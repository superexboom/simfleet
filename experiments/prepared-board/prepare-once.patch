+/// Prepare a board batch once while retaining one independent shard per run.
+/// Report-only Forma accounting does not affect the fight or its gas meter.
+pub(crate) fn board_shards_prepared(v: &Value, from: u32, count: u32) -> Value {
+    if count == 0 {
+        return json!({ "ok": true, "shards": [] });
+    }
+    let prepared = match ready(v, false) {
+        Ok(r) => r,
+        Err(e) => return e,
+    };
+    let keep = get_bool(v, "run_series", false);
+    let mut shards = Vec::with_capacity(count as usize);
+    for k in from..from.saturating_add(count) {
+        let s = wfsim_engine::fight::shard(&prepared.params, k, 1, prepared.fight.seed, keep, &mut |_| {});
+        match serde_json::to_value(&s) {
+            Ok(piece) => shards.push(piece),
+            Err(e) => return err_json(format!("shard: {e}")),
+        }
+    }
+    json!({ "ok": true, "shards": shards })
+}
