+#[cfg(test)]
+mod simfleet_cache_tests {
+    use super::*;
+    fn measured(b: &[Vec2], splash: Splash, spec: Spec, cached: bool) -> (Layout, u64) {
+        let start = crate::fight::gas::gas_now();
+        let n = if cached { Layout::build(b, splash, spec) } else { Layout::build_uncached(b, splash, spec) };
+        (n, crate::fight::gas::gas_now().wrapping_sub(start))
+    }
+    #[test]
+    fn layout_preserves_inputs_gas_and_local_acquisition() {
+        let mut b = vec![Vec2::ORIGIN, Vec2::new(3.0, 0.0), Vec2::new(6.0, 0.0)];
+        for step in 0..8 {
+            b[1].y = step as f64;
+            let splash = Splash { at: Vec2::new(step as f64, 0.0), radius_m: step as f64 };
+            let spec = Spec { hops: 5, range_m: step as f64, falloff: 0.75, compounds: true };
+            let (expected, gas) = measured(&b, splash, spec, false);
+            for _ in 0..3 {
+                let (mut actual, charge) = measured(&b, splash, spec, true);
+                assert_eq!(actual.near, expected.near);
+                assert_eq!(actual.caught, expected.caught);
+                assert!(actual.acquired.is_empty());
+                assert_eq!(actual.beams, 1);
+                assert_eq!(charge, gas);
+                actual.acquired.push(42);
+                actual.beams = 9;
+            }
+        }
+    }
