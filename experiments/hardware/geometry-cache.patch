+thread_local! {
+    static LAYOUT_CACHE: std::cell::RefCell<Option<LayoutCache>> = const { std::cell::RefCell::new(None) };
+}
+
+struct LayoutCache {
+    positions: Vec<(u64, u64)>,
+    options: [u64; 7],
+    value: Layout,
+    gas: u64,
+}
+
+impl Layout {
+    // Cache only the immutable build, before acquiring() mutates its local
+    // copy. The source body stays metered; hits pay the same measured charge.
+    pub fn build(bodies: &[Vec2], splash: Splash, spec: Spec) -> Self {
+        if bodies.len() > 512 {
+            return Self::build_uncached(bodies, splash, spec);
+        }
+        let options = [splash.at.x.to_bits(), splash.at.y.to_bits(), splash.radius_m.to_bits(),
+            u64::from(spec.hops), spec.range_m.to_bits(), spec.falloff.to_bits(), u64::from(spec.compounds)];
+        LAYOUT_CACHE.with(|slot| {
+            let mut slot = slot.borrow_mut();
+            if let Some(entry) = slot.as_ref() {
+                if entry.options == options && entry.positions.len() == bodies.len()
+                    && entry.positions.iter().zip(bodies).all(|(&(x, y), b)| x == b.x.to_bits() && y == b.y.to_bits())
+                {
+                    crate::fight::gas::charge(entry.gas);
+                    return entry.value.clone();
+                }
+            }
+            let before = crate::fight::gas::gas_now();
+            let value = Self::build_uncached(bodies, splash, spec);
+            let gas = crate::fight::gas::gas_now().wrapping_sub(before);
+            *slot = (value.near.iter().map(Vec::capacity).sum::<usize>() + value.caught.len() <= 131_072).then(|| LayoutCache {
+                positions: bodies.iter().map(|b| (b.x.to_bits(), b.y.to_bits())).collect(),
+                options, value: value.clone(), gas,
+            });
+            value
+        })
+    }
+}
