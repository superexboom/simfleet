+
+impl Neighbours {
+    // One entry per lane, bounded in size and released with its thread. Keep
+    // the original metered function body intact and replay its measured gas.
+    pub fn build(bodies: &[Vec2]) -> Self {
+        if bodies.len() > 512 {
+            return Self::build_uncached(bodies);
+        }
+        NEIGHBOUR_CACHE.with(|slot| {
+            let mut slot = slot.borrow_mut();
+            if let Some(entry) = slot.as_ref() {
+                if entry.positions.len() == bodies.len()
+                    && entry.positions.iter().zip(bodies).all(|(&(x, y), b)| x == b.x.to_bits() && y == b.y.to_bits())
+                {
+                    crate::fight::gas::charge(entry.gas);
+                    return entry.value.clone();
+                }
+            }
+            let before = crate::fight::gas::gas_now();
+            let value = Self::build_uncached(bodies);
+            let gas = crate::fight::gas::gas_now().wrapping_sub(before);
+            // At most 512 KiB of payload plus row/key headers per lane.
+            *slot = (value.near.iter().map(Vec::capacity).sum::<usize>() <= 32_768).then(|| NeighbourCache {
+                positions: bodies.iter().map(|b| (b.x.to_bits(), b.y.to_bits())).collect(),
+                value: value.clone(), gas,
+            });
+            value
+        })
+    }
 }
 
