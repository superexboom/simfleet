+/// ONE THREAD, WHATEVER A REQUEST ASKS (simfleet): a host that runs one search
+/// a thread and spreads its own work over the cores. The batch is then the
+/// wasm build's 16 and nothing is spawned, so a native search is the browser
+/// fleet's one, step for step — the seeds never depended on the thread count.
+static ONE_THREAD: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+
+pub fn one_thread() {
+    ONE_THREAD.store(true, Ordering::Relaxed);
+}
