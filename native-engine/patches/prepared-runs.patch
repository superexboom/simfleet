+/// …AND THE MERGE FROM AN ACCUMULATOR ALREADY IN MEMORY, so a caller holding
+/// one does not write it out as JSON only to read it back (simfleet).
+pub fn simulate_merged_shard_json(v: &Value, merged: wfsim_engine::fight::Shard) -> Value {
+    simulate_from(v, Work::Merged(Box::new(merged)), &mut |_, _| {})
+}
+
+/// A FIGHT PREPARED ONCE FOR MANY OF ITS RUNS (simfleet). `simulate_shard_json`
+/// parses the fight, resolves the build and builds `FightParams` on every call,
+/// and a board row is fought one run a shard, so `/api/board/runs` paid that
+/// setup once a run. The same `params` and `seed` reach the same
+/// `fight::shard`, so every shard is the bits it was.
+pub struct Prepared {
+    params: wfsim_engine::fight::FightParams,
+    seed: u64,
+    want_series: bool,
+}
+
+impl Prepared {
+    /// Run `k`'s shard, as `simulate_shard_json(v, k, 1, ..)` returns it.
+    pub fn shard_json(&self, k: u32) -> Value {
+        let s = wfsim_engine::fight::shard(&self.params, k, 1, self.seed, self.want_series, &mut |_| {});
+        serde_json::to_value(&s).unwrap_or_else(|e| err_json(format!("shard: {e}")))
+    }
+}
+
+/// `ready` for a caller that will run many shards of one request: no report.
+pub fn prepare(v: &Value) -> Result<Prepared, Value> {
+    let Ready { fight, params, .. } = ready(v, false)?;
+    Ok(Prepared { params, seed: fight.seed, want_series: get_bool(v, "run_series", false) })
+}
